# Copy to .env; .env is ignored by git. Restart server after changes.
# Never put API keys in the browser, model names, base URL, or committed files.
OPENAI_API_KEY=
# Used to create the initial default model only. Later edit model config in UI.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Additional model: enter SECOND_API_KEY as environment-variable NAME in UI.
SECOND_API_KEY=
PORT=8765
# Optional database path. Defaults to data/promptpilot.sqlite3
# PROMPTPILOT_DB=C:/path/to/promptpilot.sqlite3
